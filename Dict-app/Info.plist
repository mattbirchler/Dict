<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sparkle: where updates are announced, and the key they must be signed with.
	     Xcode merges this file with the Info.plist it generates from build settings. -->
	<key>SUFeedURL</key>
	<string>https://raw.githubusercontent.com/mattbirchler/Dict-releases/main/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>OCgTVkB0ALGcmayKSv26zkjNwtIpm61J8d7GzG8tVN4=</string>
	<!-- dictapp://activate?key=… from the purchase page. Not "dict", which
	     belongs to Apple's Dictionary. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>birchtree.Dict-app.activate</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>dictapp</string>
			</array>
		</dict>
	</array>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<!-- Chakra Petch (OFL) for the HUD; the .ttf files sit flat in Resources. -->
	<key>ATSApplicationFontsPath</key>
	<string>.</string>
</dict>
</plist>
